{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAAP Preset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "modHashes",
    "scope",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "enum": [
        "global",
        "champion",
        "queue",
        "local-account"
      ]
    },
    "localAccountId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "championId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "queueMode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "modHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 250
    },
    "clientThemeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectionMode": {
      "enum": [
        "manual",
        "random",
        "historic",
        "favorite"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
