{
  "name": "laap-control-center",
  "private": true,
  "version": "1.0.2",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,ADMIN -c cyan,magenta \"npm --workspace @laap/api run dev\" \"npm --workspace @laap/admin run dev\"",
    "dev:api": "npm --workspace @laap/api run dev",
    "dev:admin": "npm --workspace @laap/admin run dev",
    "desktop:check": "npm --workspace @laap/desktop run check",
    "desktop:check:basic": "npm --workspace @laap/desktop run check:basic",
    "desktop:test": "npm --workspace @laap/desktop run test",
    "desktop:test:basic": "npm --workspace @laap/desktop run test:basic",
    "desktop:dev": "npm --workspace @laap/desktop run dev",
    "desktop:dev:offline": "npm --workspace @laap/desktop run dev:offline",
    "desktop:dev:basic": "npm --workspace @laap/desktop run dev:basic",
    "desktop:basic": "npm --workspace @laap/desktop run tauri:basic",
    "build": "npm --workspace @laap/api run build && npm --workspace @laap/admin run build && npm --workspace @laap/desktop run build && npm --workspace @laap/landing run build",
    "desktop:build": "npm --workspace @laap/desktop run build",
    "desktop:build:basic": "npm --workspace @laap/desktop run build:basic",
    "preview": "npm --workspace @laap/admin run preview",
    "typecheck": "npm --workspace @laap/api run typecheck && npm --workspace @laap/admin run typecheck && npm --workspace @laap/landing run typecheck",
    "test": "npm --workspace @laap/api run test && npm --workspace @laap/admin run test && npm --workspace @laap/landing run test",
    "landing:dev": "npm --workspace @laap/landing run dev",
    "landing:build": "npm --workspace @laap/landing run build",
    "landing:preview": "npm --workspace @laap/landing run preview",
    "landing:typecheck": "npm --workspace @laap/landing run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
