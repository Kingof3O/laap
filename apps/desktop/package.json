{
  "name": "@laap/desktop",
  "private": true,
  "type": "module",
  "version": "0.4.6",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:lease-exit": "node --experimental-strip-types --test tests/lease-exit.test.ts",
    "test:sorting": "node --experimental-strip-types --test tests/sorting.test.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "lucide-react": "^1.35.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
