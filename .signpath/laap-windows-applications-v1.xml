<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
    <parameter name="fileVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="team/laap-desktop-core.exe" product-name="LAAP Desktop" product-version="${productVersion}" file-version="${fileVersion}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
    <pe-file path="offline/laap-desktop-core.exe" product-name="LAAP Offline" product-version="${productVersion}" file-version="${fileVersion}">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
